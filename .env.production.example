# VynGrid production environment
# Copy to /home/vyngrid/vyngrid/.env.local on server and fill secret values.

NODE_ENV=production

# VynGrid public URL (required for NextAuth callbacks)
NEXTAUTH_URL=https://grid.vynops.online
AUTH_URL=https://grid.vynops.online

# Trust reverse proxy host/proto headers
AUTH_TRUST_HOST=true

# Use a strong random secret (same value can be used for both)
NEXTAUTH_SECRET=REPLACE_WITH_32_BYTE_BASE64_SECRET
AUTH_SECRET=REPLACE_WITH_32_BYTE_BASE64_SECRET

# Admin credentials
GRID_ADMIN_USER=admin
# Base64 encoded bcrypt hash of admin password
GRID_ADMIN_PASSWORD_HASH_B64=REPLACE_WITH_BASE64_BCRYPT_HASH

# Encrypts product integration credentials and local password changes
VYNGRID_CREDENTIALS_ENCRYPTION_KEY=REPLACE_WITH_LONG_RANDOM_SECRET

# Enables subdomain links for product launch buttons
NEXT_PUBLIC_VYNGRID_DOMAIN=vynops.online
